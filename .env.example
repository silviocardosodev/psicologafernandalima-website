# Painel do site (/admin): visitas, mapa de calor e contatos. Passo a passo: docs/ADMIN.md
# Sem estas variáveis o site funciona normal: nada é registrado e o /admin mostra como configurar.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: só no servidor. Nunca coloque NEXT_PUBLIC_ nesta.
SUPABASE_SERVICE_ROLE_KEY=

# E-mails com acesso ao painel, separados por vírgula
ADMIN_EMAILS=

# Só no seu computador: abre o painel com dados de exemplo, sem banco e sem login.
# Ignorado no build de produção.
# ADMIN_DEMO=1
